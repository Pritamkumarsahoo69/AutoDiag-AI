  "dids": [
    {
      "did_hex": "0xF190",
      "name": "VIN",
      "length_bytes": 17,
      "data_type": "ASCII",
      "access": "READ_ONLY",
      "description": "Vehicle Identification Number",
      "default_value": "WVWZZZ3CZWE123456",
      "security_level": 0,
      "allowed_sessions": ["DEFAULT", "EXTENDED"]
    },
    {
      "did_hex": "0xF187",
      "name": "ECUPartNumber",
      "length_bytes": 11,
      "data_type": "ASCII",
      "access": "READ_ONLY",
      "description": "OEM Spare Part Number",
      "default_value": "06L907115AC",
      "security_level": 0,
      "allowed_sessions": ["DEFAULT", "EXTENDED"]
    },
    {
      "did_hex": "0xF189",
      "name": "ECUSoftwareVersion",
      "length_bytes": 4,
      "data_type": "ASCII",
      "access": "READ_ONLY",
      "description": "Application Software Calibration Version",
      "default_value": "V102",
      "security_level": 0,
      "allowed_sessions": ["DEFAULT", "EXTENDED"]
    },
    {
      "did_hex": "0xF199",
      "name": "ProgrammingDate",
      "length_bytes": 4,
      "data_type": "BCD",
      "access": "READ_WRITE",
      "description": "Last flashing programming date (YYYYMMDD)",
      "default_value": "20261004",
      "security_level": 1,
      "allowed_sessions": ["EXTENDED", "PROGRAMMING"]
    },
    {
      "did_hex": "0x0100",
      "name": "EngineRPM",
      "length_bytes": 2,
      "data_type": "UINT16",
      "access": "READ_ONLY",
      "description": "Current Engine Speed in RPM (0.25 rpm/bit)",
      "default_value": "0DAC",
      "security_level": 0,
      "allowed_sessions": ["DEFAULT", "EXTENDED"]
    },
    {
      "did_hex": "0x0101",
      "name": "EngineCoolantTemp",
      "length_bytes": 1,
      "data_type": "UINT8",
      "access": "READ_ONLY",
      "description": "Engine Coolant Temperature in deg C (-40 offset)",
      "default_value": "82",
      "security_level": 0,
      "allowed_sessions": ["DEFAULT", "EXTENDED"]
    },
    {
      "did_hex": "0x0200",
      "name": "IdleSpeedTarget",
      "length_bytes": 2,
      "data_type": "UINT16",
      "access": "READ_WRITE",
      "description": "Target Idle Speed calibration in RPM",
      "default_value": "0320",
      "security_level": 1,
      "allowed_sessions": ["EXTENDED"]
    }
  ],
  "routines": [
    {
      "routine_id": "0x0201",
      "name": "EraseFlashMemory",
      "supported_subfunctions": [1, 3],
      "start_payload_length": 4,
      "allowed_sessions": ["PROGRAMMING"],
      "requires_security": true,
      "security_level": 1,
      "description": "Erases application flash sector before reprogramming"
    },
    {
      "routine_id": "0x0202",
      "name": "VerifyFlashChecksum",
      "supported_subfunctions": [1, 3],
      "start_payload_length": 4,
      "allowed_sessions": ["PROGRAMMING"],
      "requires_security": true,
      "security_level": 1,
      "description": "Verifies CRC32 of uploaded flash payload"
    }
  ]
}
