      "description": "Write protected parameter DIDs"
    },
    {
      "service_id": 49,
      "name": "RoutineControl",
      "supported_subfunctions": [1, 2, 3],
      "allowed_sessions": ["EXTENDED", "PROGRAMMING"],
      "requires_security": true,
      "security_level": 1,
