      "requires_security": false,
      "security_level": 0,
      "description": "Session transitions between Default (0x01), Programming (0x02), and Extended (0x03)"
    },
    {
      "service_id": 17,
      "name": "ECUReset",
      "supported_subfunctions": [1, 2, 3],
      "allowed_sessions": ["DEFAULT", "EXTENDED", "PROGRAMMING"],
      "requires_security": false,
      "security_level": 0,
      "description": "Hard Reset (0x01), KeyOffOn (0x02), Soft Reset (0x03)"
    },
    {
      "service_id": 34,
      "name": "ReadDataByIdentifier",
      "supported_subfunctions": [],
      "allowed_sessions": ["DEFAULT", "EXTENDED"],
      "requires_security": false,
      "security_level": 0,
      "description": "Read standard and OEM specific DIDs"
    },
    {
      "service_id": 39,
      "name": "SecurityAccess",
      "supported_subfunctions": [1, 2, 3, 4],
      "allowed_sessions": ["EXTENDED", "PROGRAMMING"],
      "requires_security": false,
      "security_level": 0,
      "description": "Seed/Key exchange for Level 1 (Calibration) and Level 2 (Flashing)"
    },
    {
      "service_id": 46,
      "name": "WriteDataByIdentifier",
      "supported_subfunctions": [],
      "allowed_sessions": ["EXTENDED"],
      "requires_security": true,
